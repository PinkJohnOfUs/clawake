# Keep workspace templates tracked, ignore all runtime/user-generated workspace content.
*
!/.gitignore
!/README.md
!/developer/
!/developer/README.md
!/developer/workspace/
!/developer/workspace/README.md
!/developer/role/
!/developer/role/ROLE.md
!/product-owner/
!/product-owner/README.md
!/product-owner/workspace/
!/product-owner/workspace/README.md
!/product-owner/role/
!/product-owner/role/ROLE.md
